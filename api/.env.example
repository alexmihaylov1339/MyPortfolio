# Supabase: use pooler URLs from Dashboard → Connect.
# Direct db.* host often fails on IPv4-only networks; the pooler works for local dev.

# Transaction mode / pooled, port 6543 (runtime, Prisma `url`)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session mode / direct, port 5432 (migrations, Prisma `directUrl`)
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=

# Server port (frontend expects 3001)
PORT=3001

# Allowed CORS origin(s), comma-separated
FRONTEND_URL=http://localhost:3000

# Transactional email (forgot-password flow). Leave GMAIL_APP_PASSWORD empty to disable email sending.
EMAIL_FROM=
GMAIL_APP_PASSWORD=
