generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/** Application user (JWT auth) */
model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String?
  passwordHash           String?
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  positions              Position[]
  models                 ModelPortfolio[]
}

enum Broker {
  REVOLUT
  IBKR
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum AssetType {
  STOCK
  ETF
}

/** A manually entered investment position (open or closed) owned by a user */
model Position {
  id              String         @id @default(cuid())
  userId          String

  broker          Broker
  ticker          String
  exchangeMicCode String?
  name            String?
  assetType       AssetType      @default(STOCK)

  quantity        Decimal
  averageBuyPrice Decimal
  currency        String         @default("USD")

  status          PositionStatus @default(OPEN)
  openedAt        DateTime       @default(now())
  closedAt        DateTime?
  /** Sale price recorded when the position is closed — required to compute realized P&L; a position closed before this field existed has none and shows as price-unavailable rather than a guessed figure. */
  closePrice      Decimal?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dividends       Dividend[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, ticker])
}

/** A dividend payment received from a position, in that position's currency */
model Dividend {
  id         String   @id @default(cuid())
  positionId String
  amount     Decimal
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId])
}

/** A user-defined target allocation, compared against real positions in a later step */
model ModelPortfolio {
  id          String   @id @default(cuid())
  userId      String
  name        String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations ModelAllocation[]

  @@index([userId])
}

/** One ticker's target percentage within a ModelPortfolio */
model ModelAllocation {
  id               String  @id @default(cuid())
  modelPortfolioId String
  ticker           String
  exchangeMicCode  String?
  targetPercent    Decimal

  modelPortfolio   ModelPortfolio @relation(fields: [modelPortfolioId], references: [id], onDelete: Cascade)

  @@index([modelPortfolioId])
  @@unique([modelPortfolioId, ticker])
}

/**
 * The last price successfully fetched for a ticker+exchange pair, persisted
 * so it survives an API server restart — MarketPricesService's in-memory
 * cache alone would otherwise reset to empty on every deploy/restart,
 * making positions look priceless again until a fresh fetch succeeds.
 * micCode is "" (not null) for tickers with no exchange qualifier, so the
 * unique constraint behaves correctly (Postgres treats NULL != NULL).
 */
model MarketPrice {
  id        String   @id @default(cuid())
  ticker    String
  micCode   String   @default("")
  price     Decimal
  fetchedAt DateTime @default(now())

  @@unique([ticker, micCode])
}
